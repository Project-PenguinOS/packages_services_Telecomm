    <string name="no_vm_number_msg" msgid="4356509787635374260">"சிம் கார்டில் குரலஞ்சலுக்கான எண் எதுவும் சேமிக்கப்படவில்லை."</string>
    <string name="add_vm_number_str" msgid="7980945268907340849">"எண்ணைச் சேர்"</string>
    <string name="unblock_dialog_body" msgid="6409669116679064706">"<xliff:g id="NUMBER_TO_BLOCK">%1$s</xliff:g> தடையை நீக்கவா?"</string>
    <string name="unblock_button" msgid="2085988753097438725">"தடையை நீக்கு"</string>
    <string name="add_blocked_dialog_body" msgid="3646939382577972663">"இந்த எண்ணிலிருந்து வரும் அழைப்புகளையும் உரைச்செய்திகளையும் தடு:"</string>
    <string name="block_button" msgid="2455086271060345610">"தடு"</string>
    <string name="non_primary_user" msgid="2435380778851874271">"சாதன உரிமையாளர் மட்டுமே தடுக்கப்பட்ட எண்களைப் பார்க்கவும் நிர்வகிக்கவும் முடியும்."</string>
    <string name="blocked_numbers_number_blocked_message" msgid="3020928355060753128">"<xliff:g id="BLOCKED_NUMBER">%1$s</xliff:g> தடுக்கப்பட்டது"</string>
    <string name="blocked_numbers_number_unblocked_message" msgid="3112599598762744796">"<xliff:g id="UNBLOCKED_NUMBER">%1$s</xliff:g> தடை நீக்கப்பட்டது"</string>
    <string name="blocked_numbers_block_emergency_number_message" msgid="7109238580553660467">"அவசர உதவி எண்ணைத் தடுக்க முடியவில்லை."</string>
    <string name="blocked_numbers_number_already_blocked_message" msgid="5999222621606917984">"<xliff:g id="BLOCKED_NUMBER">%1$s</xliff:g> ஏற்கனவே தடுக்கப்பட்டது."</string>
    <string name="alert_outgoing_call" msgid="762286363406537247">"புதிய அழைப்பைச் செய்தால், செயலில் உள்ள <xliff:g id="OTHER_APP">%1$s</xliff:g> அழைப்பு துண்டிக்கப்படும்."</string>
    <string name="alert_redirect_outgoing_call_timeout" msgid="7563578831876981546">"<xliff:g id="OTHER_APP">%1$s</xliff:g> மூலம் அழைக்க முடியாது. அழைப்பைத் திருப்பிவிடுவதற்கான வேறொரு ஆப்ஸைப் பயன்படுத்திப் பார்க்கவும் அல்லது உதவிக்கு டெவெலப்பரைத் தொடர்பு கொள்ளவும்."</string>
    <string name="phone_strings_emergency_call_made_dialog_title_txt" msgid="1535746249366437841">"அவசர அழைப்பு செய்யப்பட்டது"</string>
</resources>
