package: "com.android.server.telecom.flags"
container: "system"

# OWNER=qingzhong TARGET=24Q2
flag {
  name: "skip_filter_phone_account_perform_dnd_filter"
  namespace: "telecom"
  description: "Gates whether to still perform Dnd filter when phone account has skip_filter call extra."
  bug: "222333869"
}

# OWNER=breadley TARGET=25Q4
flag {
  name: "synchronize_conn_state"
  namespace: "telecom"
  description: "Locks access to the ServiceConnection to ensure consistency of state across threads"
  bug: "409122082"
}

# OWNER=pmadapurmath TARGET=26Q1
flag {
  name: "request_focus_for_set_active"
  namespace: "telecom"
  description: "Ensure that the focus call is updated if a call is set active directly."
  bug: "445832417"
  metadata {
      purpose: PURPOSE_BUGFIX
    }
}
